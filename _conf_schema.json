{
  "takeover_wake_messages": {
    "type": "bool",
    "default": false,
    "description": "Jev 接管 @、昵称与前缀呼叫",
    "hint": "开启后先判断再回复，连续补充参与合并；已注册的命令继续交给 AstrBot。"
  },
  "enable_private_chat": {
    "type": "bool",
    "default": false,
    "description": "私聊启用 Jev",
    "hint": "私聊用户号或完整会话标识也需加入启用会话；沿用忽略名单与消息合并设置。"
  },
  "relay_mode": {
    "type": "string",
    "default": "nanbei",
    "options": [
      "typesafe",
      "nanbei",
      "custom"
    ],
    "labels": [
      "Jev 官方",
      "南北绿豆（推荐）",
      "自定义 Jev 格式中转"
    ],
    "description": "判断服务",
    "hint": "只用 Jev 判断。自定义中转须是 Jev systemone 协议（不是 OpenAI chat/completions）。开启渠道互备时，其余已填 Key 的服务作为备用。"
  },
  "relay": {
    "type": "object",
    "description": "自定义 Jev 格式中转",
    "condition": {
      "relay_mode": "custom"
    },
    "items": {
      "base_url": {
        "type": "string",
        "default": "",
        "description": "HTTPS Base URL",
        "hint": "可填站点地址、带 /v1 的地址或完整 /v1/systemone 地址。"
      },
      "api_key": {
        "type": "string",
        "default": "",
        "secret": true,
        "description": "API Key"
      },
      "model": {
        "type": "string",
        "default": "jev-latest",
        "description": "模型"
      },
      "concurrency": {
        "type": "int",
        "default": 4,
        "description": "中转并发上限"
      }
    }
  },
  "enabled": {
    "type": "bool",
    "default": true,
    "description": "启用主动回复",
    "invisible": false
  },
  "enabled_sessions": {
    "type": "list",
    "default": [],
    "description": "启用会话",
    "hint": "填写群号、私聊用户号或完整会话标识；填 * 表示全部。私聊需打开私聊开关。",
    "invisible": false
  },
  "nanbei": {
    "type": "object",
    "description": "南北绿豆站",
    "items": {
      "keys": {
        "type": "list",
        "default": [],
        "description": "API Key",
        "hint": "使用南北绿豆站 Jev 分组的 Key；支持多枚。",
        "invisible": false
      },
      "quota_group_ids": {
        "type": "list",
        "default": [],
        "description": "本站 Key 对应的账户配额组（一般留空）",
        "hint": "同一账户的多个 Key 不会增加账户余额。上游官方号池由站点维护，无需在插件重复填写。",
        "invisible": true
      },
      "endpoint": {
        "type": "string",
        "default": "https://hajimi.165201.xyz/v1/systemone",
        "description": "南北绿豆站 Jev 原生接口",
        "invisible": true
      },
      "model": {
        "type": "string",
        "default": "jev-latest",
        "description": "本站模型名称",
        "invisible": true
      },
      "quota_rpm": {
        "type": "int",
        "default": 0,
        "description": "兼容旧配置（默认不限制）",
        "invisible": true
      },
      "key_rpm": {
        "type": "int",
        "default": 0,
        "description": "兼容旧配置（默认不限制）",
        "invisible": true
      },
      "concurrency": {
        "type": "int",
        "default": 8,
        "description": "池并发上限，每枚 Key 最多一个在途请求",
        "invisible": true
      },
      "daily_request_limit": {
        "type": "int",
        "default": 0,
        "description": "兼容旧配置（默认不限制）",
        "invisible": true
      }
    },
    "invisible": false,
    "condition": {
      "relay_mode": "nanbei"
    }
  },
  "typesafe": {
    "type": "object",
    "description": "Jev 官方",
    "items": {
      "keys": {
        "type": "list",
        "default": [],
        "description": "API Key",
        "hint": "填写官方 apikey_ Key；支持多枚。",
        "invisible": false
      },
      "quota_group_ids": {
        "type": "list",
        "default": [],
        "description": "Key 对应的账户配额组，可留空",
        "hint": "留空表示所有 Key 共用同一账户额度。填写时须与 Keys 一一对应，同账户填同一组名。不要靠多 Key 绕过同账户限额。",
        "invisible": true
      },
      "endpoint": {
        "type": "string",
        "default": "https://api.typesafe.ai/v1/systemone",
        "description": "官方格式端点",
        "invisible": true
      },
      "model": {
        "type": "string",
        "default": "jev-latest",
        "description": "官方模型名称",
        "invisible": true
      },
      "quota_rpm": {
        "type": "int",
        "default": 0,
        "description": "兼容旧配置（默认不限制）",
        "invisible": true
      },
      "key_rpm": {
        "type": "int",
        "default": 0,
        "description": "兼容旧配置（默认不限制）",
        "invisible": true
      },
      "concurrency": {
        "type": "int",
        "default": 8,
        "description": "池并发上限，每枚 Key 最多一个在途请求",
        "invisible": true
      },
      "daily_request_limit": {
        "type": "int",
        "default": 0,
        "description": "兼容旧配置（默认不限制）",
        "invisible": true
      }
    },
    "invisible": false,
    "condition": {
      "relay_mode": "typesafe"
    }
  },
  "style": {
    "type": "string",
    "default": "balanced",
    "options": [
      "quiet",
      "balanced",
      "sociable"
    ],
    "description": "参与程度",
    "invisible": false,
    "labels": [
      "安静",
      "自然",
      "活跃"
    ]
  },
  "behavior_guidance": {
    "type": "text",
    "default": "",
    "description": "聊天偏好",
    "hint": "可留空。例如：多接梗、少说教，回答简短一点。",
    "invisible": false
  },
  "wake_names": {
    "type": "list",
    "default": [],
    "description": "Bot 昵称",
    "hint": "句首叫到昵称时直接回应；可留空。",
    "invisible": false
  },
  "burst_window_seconds": {
    "type": "float",
    "default": 10,
    "description": "连续消息合并窗口（秒）",
    "hint": "同一人短时间内补充消息时合并，减少重复回复；首条不必等满窗口。",
    "invisible": false
  },
  "silence": {
    "type": "object",
    "description": "忽略名单",
    "items": {
      "enable": {
        "type": "bool",
        "default": true,
        "description": "开启内置沉默与忽略功能",
        "invisible": true
      },
      "tool_enable": {
        "type": "bool",
        "default": true,
        "description": "允许主模型调用 keep_silent 结束本轮",
        "invisible": true
      },
      "sessions": {
        "type": "list",
        "default": [
          "*"
        ],
        "description": "沉默与忽略功能的会话范围",
        "hint": "独立于主动接话群范围，可填群号、UMO 或 *；仅影响启用了本插件的会话。影子模式不干预。",
        "invisible": true
      },
      "normal_replies": {
        "type": "bool",
        "default": true,
        "description": "普通群聊呼叫也允许主模型自主沉默",
        "hint": "不让显式呼叫多跑两次 Jev；仅提供沉默工具。",
        "invisible": true
      },
      "private_replies": {
        "type": "bool",
        "default": true,
        "description": "私聊允许主模型自主沉默",
        "invisible": true
      },
      "must_reply_uid": {
        "type": "list",
        "default": [],
        "description": "禁止使用沉默工具的用户",
        "hint": "同时豁免本忽略名单，但不强制放行 Jev 自主判断、其他过滤或配额。",
        "invisible": true
      },
      "must_reply_gid": {
        "type": "list",
        "default": [],
        "description": "禁止使用沉默工具的群",
        "invisible": true
      },
      "must_reply_umo": {
        "type": "list",
        "default": [],
        "description": "禁止使用沉默工具的完整会话 UMO",
        "invisible": true
      },
      "ignored_users": {
        "type": "list",
        "default": [],
        "description": "忽略用户",
        "hint": "填写用户 QQ 号。",
        "invisible": false
      },
      "ignored_sessions": {
        "type": "list",
        "default": [],
        "description": "忽略整个会话（完整 UMO）",
        "invisible": true
      },
      "ignored_group_users": {
        "type": "list",
        "default": [],
        "description": "仅在指定群忽略",
        "invisible": false,
        "hint": "格式：群号:QQ号。"
      },
      "protected_admins": {
        "type": "bool",
        "default": true,
        "description": "忽略名单保护 AstrBot 管理员",
        "invisible": true
      },
      "blocked_context_window": {
        "type": "int",
        "default": 20,
        "description": "忽略用户背景最多条数（1–200）",
        "invisible": true
      },
      "blocked_context_ttl_seconds": {
        "type": "int",
        "default": 86400,
        "description": "忽略背景缓存秒数（60–604800）",
        "hint": "仅内存临时缓存；重载清空。撤回只清对应消息、不吞通知。每群64KB、全局2MB硬上限，超长背景明确标记截短。",
        "invisible": true
      }
    },
    "invisible": false
  },
  "show_advanced": {
    "type": "bool",
    "default": false,
    "description": "更多设置"
  },
  "advanced": {
    "type": "object",
    "description": "更多设置",
    "hint": "升级会保留旧值。日预算不是余额；默认不设额外日上限。修改后保存并重载生效。",
    "items": {
      "judgment": {
        "type": "object",
        "description": "接话方式",
        "items": {
          "decision_mode": {
            "type": "string",
            "default": "natural",
            "options": [
              "natural",
              "classic"
            ],
            "description": "判断方式：natural 直接判断是否自然接话；classic 使用旧版四项阈值",
            "invisible": true
          },
          "second_review": {
            "type": "string",
            "default": "adaptive",
            "options": [
              "adaptive",
              "off",
              "selective",
              "always"
            ],
            "description": "发送前复查",
            "hint": "智能检查只在聊天发生变化时复查，减少无谓等待。",
            "invisible": false,
            "labels": [
              "智能检查（推荐）",
              "关闭",
              "重点检查",
              "每次检查"
            ]
          },
          "natural_reply_threshold": {
            "type": "float",
            "default": 0.5,
            "description": "自然判断基础门槛（通常无需修改）",
            "hint": "活跃程度在此基础上调整。不是经校准的正确率。",
            "invisible": true
          },
          "question_overrides": {
            "type": "text",
            "default": "",
            "description": "高级：判断问题措辞/标准覆盖 JSON",
            "hint": "可覆盖 reply_now、still_fits 或旧版六项判断，通常留空。不改变 noul 类型。",
            "invisible": true
          },
          "uncertain_adjudication": {
            "type": "bool",
            "default": true,
            "description": "临界候选交给拥有完整记忆的主模型再判断",
            "invisible": true
          },
          "address_threshold": {
            "type": "float",
            "default": 0.8,
            "description": "间接对 Bot 说话的门槛（0–1）",
            "invisible": true
          },
          "continuation_threshold": {
            "type": "float",
            "default": 0.7,
            "description": "自然续聊门槛（0–1）",
            "invisible": true
          },
          "response_value_threshold": {
            "type": "float",
            "default": 0.5,
            "description": "接话最低价值/自然反应分（0–1）",
            "invisible": true
          },
          "intrusion_threshold": {
            "type": "float",
            "default": 0.45,
            "description": "打扰分达到此值则沉默（0–1）",
            "invisible": true
          },
          "join_threshold_offset": {
            "type": "float",
            "default": 0,
            "description": "主动加入话题的门槛偏移，正值更克制",
            "invisible": true
          },
          "join_intrusion_ceiling": {
            "type": "float",
            "default": 0.2,
            "description": "主动加入时允许的最高打扰分（0–1）",
            "invisible": true
          },
          "review_appropriate_threshold": {
            "type": "float",
            "default": 0.75,
            "description": "二审合适程度最低分（0–1）",
            "invisible": true
          },
          "review_redundancy_ceiling": {
            "type": "float",
            "default": 0.35,
            "description": "二审重复程度最高分（0–1）",
            "invisible": true
          },
          "image_decision_mode": {
            "type": "string",
            "default": "text_gate",
            "options": [
              "native_vision",
              "text_gate"
            ],
            "description": "图片消息",
            "hint": "默认先按文字和聊天语境筛选，值得回复时再让主模型看图。",
            "invisible": false,
            "labels": [
              "直接交给主模型看图",
              "按语境筛选（推荐）"
            ]
          },
          "max_autonomous_reply_chars": {
            "type": "int",
            "default": 2000,
            "description": "自主回复最长字符数，超出则沉默（200–20000）",
            "invisible": true
          }
        }
      },
      "timing": {
        "type": "object",
        "description": "聊天节奏",
        "items": {
          "debounce_seconds": {
            "type": "float",
            "default": 0,
            "description": "首次判断前额外等待秒数（0–5）",
            "hint": "默认不固定等待。连续补充由下方窗口监听；这不是合并窗口。",
            "invisible": true
          },
          "burst_merge_enabled": {
            "type": "bool",
            "default": true,
            "description": "同人连续补充合并：先判断生成，未输出时替换旧轮",
            "hint": "按群/会话/发送者独立管理，别人插话不混串。已发送或正在投递不合并重放；仅原生自主候选参与。",
            "invisible": true
          },
          "burst_max_messages": {
            "type": "int",
            "default": 8,
            "description": "一次连续补充最多合并几条（2–12）",
            "invisible": true
          },
          "candidate_wait_seconds": {
            "type": "int",
            "default": 15,
            "description": "最新候选等待当前自主轮收尾的上限（1–30秒）",
            "invisible": true
          },
          "continuation_min_interval": {
            "type": "float",
            "default": 1,
            "description": "同人续聊最低间隔秒数（不作为自动回复许可）",
            "invisible": true
          },
          "request_lifetime_seconds": {
            "type": "int",
            "default": 90,
            "description": "自主请求最长生命周期秒数（15–180）",
            "invisible": true
          },
          "evaluation_interval": {
            "type": "int",
            "default": 10,
            "description": "同群 Jev 评估最小间隔秒数",
            "invisible": true
          },
          "min_reply_interval": {
            "type": "int",
            "default": 8,
            "description": "主动插话间隔（秒）",
            "invisible": false,
            "hint": "避免连续主动插话；不是 API 请求限速。"
          },
          "continuation_seconds": {
            "type": "int",
            "default": 180,
            "description": "自然续聊时间（秒）",
            "invisible": false,
            "hint": "刚参与过的话题，在这段时间内更容易继续接话。"
          },
          "direct_wake_interval": {
            "type": "float",
            "default": 0.5,
            "description": "同人显式呼叫最低间隔秒数（0–10）",
            "hint": "保留旧唤醒冷却能力；0 关闭，不替代自主回复的合并窗口。豁免名单不受限制。",
            "invisible": true
          },
          "local_prefilter_enabled": {
            "type": "bool",
            "default": true,
            "description": "Jev 前本地过滤",
            "invisible": false
          },
          "prefilter_cooldown_seconds": {
            "type": "float",
            "default": 20,
            "description": "同话题本地冷却秒数",
            "invisible": false
          }
        }
      },
      "context": {
        "type": "object",
        "description": "上下文",
        "items": {
          "persona_override": {
            "type": "text",
            "default": "",
            "description": "判断人设覆盖（一般留空自动读取）",
            "hint": "只影响 Jev 判断，不覆盖主模型人格；自动按 UMO 与 conversation 解析。",
            "invisible": true
          },
          "read_life_schedule": {
            "type": "bool",
            "default": true,
            "description": "读取已有生活日程，不生成新日程",
            "invisible": true
          },
          "interest_topics": {
            "type": "list",
            "default": [],
            "description": "人设补充兴趣主题",
            "hint": "仅作为语义判断背景，不是见词必回或随机唤醒。与人设冲突时以人设为准。",
            "invisible": true
          },
          "context_mode": {
            "type": "string",
            "default": "quality",
            "options": [
              "quality",
              "balanced",
              "economy"
            ],
            "description": "判断上下文",
            "hint": "效果优先会保留更多原文；接近模型容量时才整理旧消息。",
            "invisible": false,
            "labels": [
              "效果优先（推荐）",
              "均衡",
              "精简"
            ]
          },
          "context_message_limit": {
            "type": "int",
            "default": 40,
            "description": "参考消息数",
            "invisible": false,
            "hint": "用于判断是否接话，不改变主模型的上下文配置。"
          },
          "overflow_evidence_policy": {
            "type": "string",
            "default": "summarize",
            "options": [
              "summarize",
              "reject"
            ],
            "description": "二审辅助证据确实超预算时的处理",
            "hint": "summarize 仅在超限时使用当前主模型整理辅助记忆/场景，保留人设与目标原文，并标记为有损摘要；增加一次主模型调用，不改生成模型原始上下文。reject 则暂停该轮。",
            "invisible": true
          },
          "overflow_summary_timeout": {
            "type": "int",
            "default": 20,
            "description": "超预算辅助证据整理超时秒数（5–30）",
            "invisible": true
          },
          "protected_recent_messages": {
            "type": "int",
            "default": 4,
            "description": "预算不足时保护的最近消息数（1–8）",
            "invisible": true
          },
          "context_safety_margin": {
            "type": "float",
            "default": 0.15,
            "description": "估算 token 安全余量（0.05–0.4）",
            "hint": "不是供应商精确 tokenizer；同时检查 state+最长问题及整包约束，并保留字节硬上限。",
            "invisible": true
          },
          "request_byte_budget": {
            "type": "int",
            "default": 192000,
            "description": "Jev 整包 UTF-8 字节硬上限（8000–524288）",
            "invisible": true
          }
        }
      },
      "guards": {
        "type": "object",
        "description": "互动习惯",
        "items": {
          "admin_wake_names": {
            "type": "list",
            "default": [],
            "description": "仅 AstrBot 管理员可用的短昵称",
            "invisible": true
          },
          "reply_to_bot_wakes": {
            "type": "bool",
            "default": true,
            "description": "引用 Bot 时直接回应",
            "invisible": false,
            "hint": ""
          },
          "skip_reply_to_others": {
            "type": "bool",
            "default": false,
            "description": "引用其他人时不主动接话",
            "invisible": true
          },
          "blocked_targets": {
            "type": "list",
            "default": [],
            "description": "全阻塞名单：QQ、群号或 UMO",
            "invisible": true
          },
          "guard_exempt_targets": {
            "type": "list",
